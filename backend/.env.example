APP_NAME=ForgeMind AI API
ENVIRONMENT=development

# Local default
DATABASE_URL=sqlite:///./forgemind.db
# Supabase Session Pooler example, backend only. Never commit a real value.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

STORAGE_DIR=./storage
PREDICTIVE_MODEL_PATH=./ml/models/predictive_maintenance.joblib
PREDICTIVE_METADATA_PATH=./ml/models/predictive_maintenance.metadata.json
QUALITY_MODEL_PATH=./ml/models/quality_inspector.joblib
QUALITY_METADATA_PATH=./ml/models/quality_inspector.metadata.json
METROPT_MODEL_PATH=./ml/models/metropt_air_compressor.joblib
METROPT_METADATA_PATH=./ml/models/metropt_air_compressor.metadata.json

CORS_ORIGINS=http://localhost:3000
SECRET_KEY=replace-with-at-least-32-random-characters
TOKEN_HOURS=12
DEVICE_API_KEY=replace-with-a-random-device-key
LOCAL_RECOVERY_KEY=replace-with-a-private-recovery-key
MAX_UPLOAD_MB=12
ALLOW_LOCAL_REGISTRATION=true
SEED_DEFAULT_USERS=true

# Optional external LLM layer. The local assistant works without it.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Production hardening
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
RATE_LIMIT_BACKEND=memory
REDIS_URL=

# Optional Supabase Storage (server-side only; never expose service role key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=forgemind-private
